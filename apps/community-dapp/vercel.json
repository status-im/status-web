{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "develop": false,
      "master": false,
      "dependabot/npm_and_yarn/playwright-*": false,
      "docs/**": false,
      "**/*-no-deploy": false
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in develop|master) exit 1 ;; esac; git diff --quiet HEAD^ HEAD ../../{patches,package.json,turbo.json} ../../packages/{status-js,community-contracts} ./",
  "installCommand": "pnpm install --ignore-scripts",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
